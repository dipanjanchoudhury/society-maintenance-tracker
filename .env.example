# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/society_tracker
SECRET_KEY=supersecretjwtkeythatisreallylongandsecure123456!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Config
UPLOAD_DIR=/uploads
MAX_FILE_SIZE_MB=5

# Email Settings (for mock console output or real SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@societytracker.com
USE_MOCK_EMAIL=true

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:5173
